      "parameters": {
        "jsCode": "const r = $json || {};\nconst cfg = $('Workflow Config').first().json || {};\n\nfunction driveFileId(url) {\n  const s = String(url || '');\n  const m1 = s.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n  if (m1) return m1[1];\n  const m2 = s.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n  if (m2) return m2[1];\n  return '';\n}\n\nconst fileId = driveFileId(r['Drive Image URL']);\nif (!fileId) throw new Error('Could not extract Google Drive file ID from Drive Image URL.');\n\nconst caption = String(r['Caption'] || '').trim();\nif (!caption) throw new Error('Caption is empty.');\n\nconst postId = encodeURIComponent(String(r['Post ID'] || '').trim());\nconst baseUrl = String(cfg.n8n_base_url || '').replace(/\\/$/, '');\nif (!baseUrl || baseUrl.includes('YOUR-N8N-DOMAIN')) {\n  throw new Error('Set n8n_base_url in Workflow Config.');\n}\n\nreturn [{\n  json: {\n    ...r,\n    public_image_url: `https://drive.google.com/uc?export=download&id=${fileId}`,\n    approver_email: String(cfg.approver_email || '').trim(),\n    timezone: 'Asia/Kolkata',\n    approve_url: `${baseUrl}/webhook/social-post-approve?post_id=${postId}`,\n    reject_url: `${baseUrl}/webhook/social-post-reject?post_id=${postId}`\n  }\n}];"
      },
