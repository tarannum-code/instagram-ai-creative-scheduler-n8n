        "sendTo": "={{ $('Prepare Post').item.json.approver_email }}",
        "subject": "=Approve Instagram Post — {{ $('Prepare Post').item.json['Post ID'] }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:650px\">\n<h2>Instagram post approval</h2>\n<p><strong>Post ID:</strong> {{ $('Prepare Post').item.json['Post ID'] }}</p>\n<p><strong>Scheduled:</strong> {{ $('Prepare Post').item.json['Post Date'] }} {{ $('Prepare Post').item.json['Post Time'] }} IST</p>\n<p><strong>Topic:</strong> {{ $('Prepare Post').item.json['Topic'] || '-' }}</p>\n<p><img src=\"{{ $('Prepare Post').item.json.public_image_url }}\" style=\"max-width:520px;width:100%;height:auto;border-radius:8px\"></p>\n<p><strong>Caption</strong></p>\n<p style=\"white-space:pre-wrap\">{{ $('Prepare Post').item.json['Caption'] }}</p>\n<p>\n<a href=\"{{ $('Prepare Post').item.json.approve_url }}\" style=\"display:inline-block;padding:12px 20px;background:#188038;color:#fff;text-decoration:none;border-radius:6px;margin-right:10px\">Approve</a>\n<a href=\"{{ $('Prepare Post').item.json.reject_url }}\" style=\"display:inline-block;padding:12px 20px;background:#d93025;color:#fff;text-decoration:none;border-radius:6px\">Reject</a>\n</p>\n</div>",
