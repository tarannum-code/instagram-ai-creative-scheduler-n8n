    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst out = [];\n\nfor (const item of rows) {\n  const r = item.json || {};\n  const postId = String(r['Post ID'] || '').trim();\n  const driveUrl = String(r['Drive Image URL'] || '').trim();\n  const caption = String(r['Caption'] || '').trim();\n  const status = String(r['Buffer Status'] || '').trim().toLowerCase();\n\n  if (!postId || !driveUrl || !caption) continue;\n  if (['awaiting approval','scheduled','posted','rejected'].includes(status)) continue;\n\n  out.push({ json: r });\n}\n\nreturn out;"
      },
