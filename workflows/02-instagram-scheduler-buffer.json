    {
      "parameters": {
        "jsCode": "const postId = String($('Approve Post').first().json.query?.post_id || '').trim();\nif (!postId) throw new Error('Missing post_id in approval URL.');\n\nconst rows = $input.all();\nconst match = rows.find(i => String(i.json['Post ID'] || '').trim() === postId);\nif (!match) throw new Error(`Post ID ${postId} was not found in the sheet.`);\n\nconst r = match.json;\nconst status = String(r['Buffer Status'] || '').trim().toLowerCase();\n\nif (status === 'scheduled' || status === 'posted') {\n  throw new Error(`Post ${postId} is already ${status}.`);\n}\n\nfunction driveFileId(url) {\n  const s = String(url || '');\n  const m1 = s.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n  if (m1) return m1[1];\n  const m2 = s.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n  return m2 ? m2[1] : '';\n}\n\nconst fileId = driveFileId(r['Drive Image URL']);\nif (!fileId) throw new Error('Could not extract Drive file ID.');\n\nreturn [{\n  json: {\n    ...r,\n    timezone: 'Asia/Kolkata',\n    public_image_url: `https://drive.google.com/uc?export=download&id=${fileId}`\n  }\n}];"
      },
      "id": "bb166541-e8c0-4a52-9acd-ce0ce47a0c23",
      "name": "Find Approved Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json || {};\n\n// Fixed Buffer Instagram channel\nconst channelId = 'YOUR_BUFFER_CHANNEL_ID';\n\n// Caption\nconst caption = String(r['Caption'] || '').trim();\n\nif (!caption) {\n  throw new Error('Caption is empty.');\n}\n\n// Post type from sheet\nconst postType = String(r['Post Type'] || 'post')\n  .trim()\n  .toLowerCase();\n\nif (!['post', 'reel'].includes(postType)) {\n  throw new Error(\n    `Invalid Post Type: ${postType}. Use only \"post\" or \"reel\".`\n  );\n}\n\n// Date + time\nconst date = String(r['Post Date'] || '').trim();\nconst time = String(r['Post Time'] || '').trim();\n\nif (!date) {\n  throw new Error('Post Date is empty.');\n}\n\nif (!time) {\n  throw new Error('Post Time is empty.');\n}\n\n// Parse in India timezone\nlet dt = DateTime.fromFormat(\n  `${date} ${time}`,\n  'yyyy-MM-dd HH:mm',\n  { zone: 'Asia/Kolkata' }\n);\n\nif (!dt.isValid) {\n  dt = DateTime.fromFormat(\n    `${date} ${time}`,\n    'dd-MM-yyyy HH:mm',\n    { zone: 'Asia/Kolkata' }\n  );\n}\n\nif (!dt.isValid) {\n  dt = DateTime.fromFormat(\n    `${date} ${time}`,\n    'dd/MM/yyyy HH:mm',\n    { zone: 'Asia/Kolkata' }\n  );\n}\n\nif (!dt.isValid) {\n  throw new Error(\n    `Invalid Post Date/Post Time. Use YYYY-MM-DD and HH:mm. Received: ${date} ${time}`\n  );\n}\n\nconst dueAt = dt.toUTC().toISO();\n\n// Public Drive media URL\nconst mediaUrl = String(r.public_image_url || '').trim();\n\nif (!mediaUrl) {\n  throw new Error('Public media URL is missing.');\n}\n\n// -----------------------------------------------------\n// ASSET TYPE\n//\n// post -> image\n// reel -> video\n// -----------------------------------------------------\n\nlet assetBlock = '';\n\nif (postType === 'post') {\n  assetBlock = `\n    assets: [\n      {\n        image: {\n          url: ${JSON.stringify(mediaUrl)}\n        }\n      }\n    ]\n  `;\n}\n\nif (postType === 'reel') {\n  assetBlock = `\n    assets: [\n      {\n        video: {\n          url: ${JSON.stringify(mediaUrl)}\n        }\n      }\n    ]\n  `;\n}\n\n// -----------------------------------------------------\n// BUFFER GRAPHQL\n// -----------------------------------------------------\n\nconst q = `\nmutation CreateInstagramPost {\n  createPost(\n    input: {\n      text: ${JSON.stringify(caption)}\n\n      channelId: ${JSON.stringify(channelId)}\n\n      schedulingType: automatic\n\n      mode: customScheduled\n\n      dueAt: ${JSON.stringify(dueAt)}\n\n      ${assetBlock}\n\n      metadata: {\n        instagram: {\n          type: ${postType}\n          shouldShareToFeed: true\n        }\n      }\n    }\n  ) {\n    ... on PostActionSuccess {\n      post {\n        id\n        text\n        dueAt\n        status\n\n        assets {\n          id\n          mimeType\n        }\n      }\n    }\n\n    ... on MutationError {\n      message\n    }\n  }\n}`;\n\nreturn [\n  {\n    json: {\n      ...r,\n\n      buffer_channel_id: channelId,\n      buffer_channel_name: 'your_instagram_handle',\n\n      instagram_post_type: postType,\n\n      due_at: dueAt,\n\n      buffer_query: q\n    }\n  }\n];"
      },
      "id": "812e8bb6-b0ee-4407-89e3-c245a7aa6f73",
      "name": "Build Buffer Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        448
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.buffer.com",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_BUFFER_API_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ query: $json.buffer_query }) }}",
        "options": {}
      },
      "id": "24a3add8-4fee-4f35-a65e-ef1c6da5ca37",
      "name": "Schedule in Buffer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json || {};\nconst source = $('Build Buffer Request').item.json || {};\nconst result = resp.data?.createPost;\n\nif (!result) {\n  throw new Error('Buffer returned no createPost result: ' + JSON.stringify(resp).slice(0, 800));\n}\n\nif (result.message && !result.post) {\n  throw new Error('Buffer error: ' + result.message);\n}\n\nif (!result.post?.id) {\n  throw new Error('Buffer did not return a post ID: ' + JSON.stringify(resp).slice(0, 800));\n}\n\nreturn [{\n  json: {\n    ...source,\n    buffer_post_id: result.post.id,\n    buffer_due_at: result.post.dueAt || source.due_at,\n    buffer_status: result.post.status || 'scheduled'\n  }\n}];"
      },
